# 한국은행 ECOS OpenAPI  https://ecos.bok.or.kr/api/
ECOS_KEY=

# 공공데이터포털 (조달청 비축물자 / KOTRA 해외진출기업)  https://www.data.go.kr
DATA_GO_KR_KEY=

# UN Comtrade  https://comtradeplus.un.org
COMTRADE_KEY=
